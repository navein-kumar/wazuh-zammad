# Zammad Production Configuration
VERSION=6.5.2
RESTART=always

# Database Configuration
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=zammad_secure_prod_2024
POSTGRES_HOST=zammad-postgresql
POSTGRES_PORT=5432

# Domain Configuration
ZAMMAD_FQDN=ir.codesec.in
NGINX_SERVER_NAME=ir.codesec.in
NGINX_SERVER_SCHEME=https

# Nginx Configuration
NGINX_PORT=8080
NGINX_EXPOSE_PORT=8080
NGINX_CLIENT_MAX_BODY_SIZE=50m

# Security
RAILS_TRUSTED_PROXIES=172.16.0.0/12

# Performance
ZAMMAD_WEB_CONCURRENCY=1
ZAMMAD_PROCESS_SESSIONS_JOBS_WORKERS=1
ZAMMAD_PROCESS_SCHEDULED_JOBS_WORKERS=1
ZAMMAD_PROCESS_DELAYED_JOBS_WORKERS=1

# Elasticsearch Configuration (ENABLED for reporting)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_SCHEMA=http
ELASTICSEARCH_HOST=zammad-elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NAMESPACE=zammad
ELASTICSEARCH_REINDEX=true
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Timezone
TZ=Asia/Kolkata

# Backup Configuration

# Memcached Configuration
MEMCACHE_VERSION=1.6.39-alpine

# Redis Configuration
REDIS_VERSION=7.4.5-alpine

# PostgreSQL Configuration
POSTGRES_VERSION=17.6-alpine

